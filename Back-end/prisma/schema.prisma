generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Etudiant {
  uid            String         @id @default(uuid())
  email          String         @unique
  nom            String
  prenom         String
  motDePasse     String

  niveauEtude    String?
  cvUrl          String?
  bio            String?
  competences    String[]

  emailVerified  Boolean        @default(false)
  verifyToken    String?

  candidatures   Candidature[]
}

model Admin {
  uid             String         @id @default(uuid())
  email           String         @unique
  nomAdmin        String
  description     String?
  photoProfilUrl  String?

  motDePasse      String

  emailVerified   Boolean        @default(false)
  verifyToken     String?

  offres          Offre[]
}

model Offre {
  id               String   @id @default(uuid())
  adminId          String

  // ── Hero card ──
  nomPoste         String
  nomEntreprise    String
  initiale         String?           // "C" pour Coexya
  typeContrat      String            // "Stage", "CDI", etc.
  lieu             String
  salaire          String?           // "15 000 – 17 000 € / an"
  niveauEtudes     String?           // "Bac +2 à Bac +5"
  secteur          String?           // "Informatique · ESN"
  reference        String?           // "SIPCDINET"
  datePublication  DateTime          @default(now())

  // ── Badges ──
  isSuperRecruteur Boolean           @default(false)
  isReactif        Boolean           @default(false)
  isTransparent    Boolean           @default(false)

  // ── Corps de l'offre ──
  description      String
  missions         String[]          // liste de strings
  profilRecherche  String[]          // liste de strings
  avantages        String[]          // ["🏥 Mutuelle", "🍽️ Tickets restaurant"]

  // ── Étapes de recrutement ──
  etapesRecrutement Json?
  // Format : [{ titre: "Préqualification", description: "..." }, ...]

  // ── Sidebar recruteur ──
  delaiReponse     String?           // "15 jours"

  admin            Admin             @relation(fields: [adminId], references: [uid])
  candidatures     Candidature[]
}

model Candidature {
  id                   String      @id @default(uuid())

  offreId              String
  etudiantId           String

  lettreMotivationUrl  String
  messageAdditionnel   String?

  createdAt            DateTime    @default(now())

  offre                Offre       @relation(fields: [offreId], references: [id])
  etudiant             Etudiant    @relation(fields: [etudiantId], references: [uid])
}