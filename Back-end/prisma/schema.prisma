generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Etudiant {
  uid            String         @id @default(uuid())
  email          String         @unique
  motDePasse     String
  nom            String
  prenom         String
  emailVerified  Boolean        @default(false)
  verifyToken    String?
  emailConnecte  Boolean        @default(false)
  providerMail   MailProvider?
  candidatures   Candidature[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Candidature {
  id            String   @id @default(uuid())
  nomPoste      String
  nomEntreprise String
  plateforme    String?
  dateDepot     DateTime
  sourceUrl     String?
  etudiantId    String
  etudiant      Etudiant @relation(fields: [etudiantId], references: [uid])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Ecole {
  id                String      @id @default(uuid())
  nomEtablissement  String
  typeEtablissement String
  logo              String?
  siteWeb           String?
  emailPro          String      @unique
  telephone         String
  adresse           String
  ville             String
  codePostal        String
  pays              String
  description       String
  password          String
  formations        Formation[]
  offres            Offre[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Formation {
  id      String @id @default(uuid())
  nom     String
  ecoleId String
  ecole   Ecole  @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
}

model Offre {
  id          String   @id @default(uuid())
  titre       String
  description String?
  ecoleId     String
  ecole       Ecole    @relation(fields: [ecoleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

enum MailProvider {
  GMAIL
  OUTLOOK
}