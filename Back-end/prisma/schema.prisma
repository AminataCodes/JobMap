generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Etudiant {
  uid            String         @id @default(uuid())

  email          String         @unique
  motDePasse     String

  nom            String
  prenom         String

  emailVerified  Boolean        @default(false)
  verifyToken    String?

  emailConnecte  Boolean        @default(false)
  providerMail   MailProvider?

  candidatures   Candidature[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Candidature {
  id             String         @id @default(uuid())

  nomPoste       String
  nomEntreprise  String

  plateforme     String?

  dateDepot      DateTime

  sourceUrl      String?

  etudiantId     String
  etudiant       Etudiant       @relation(fields: [etudiantId], references: [uid])

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum MailProvider {
  GMAIL
  OUTLOOK
}